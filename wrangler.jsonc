{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "probamo-website",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Serve 404.html with a 404 status for unknown URLs
    "not_found_handling": "404-page"
  }
}
