{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "probamo-website",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve 404.html with a 404 status for unknown URLs
    "not_found_handling": "404-page",
    // Send form submissions to the Worker before looking for a file
    "run_worker_first": ["/api/*"]
  }
}
